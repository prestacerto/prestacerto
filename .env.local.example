# Copie este arquivo para .env.local e preencha com as credenciais do seu
# projeto Supabase (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Service role key — NUNCA exponha no cliente. Só rotas de servidor usam
# (checkout e webhook do Mercado Pago). Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-secreta

# URL pública do site — usada nos redirects do Mercado Pago.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mercado Pago — aplicação de marketplace (split payments).
# Painel: https://www.mercadopago.com.br/developers/panel/app
# Ative "Checkout Pro" e "Split de pagamentos" e pegue as credenciais.
MERCADOPAGO_CLIENT_ID=seu-client-id
MERCADOPAGO_CLIENT_SECRET=seu-client-secret

# Public key DA APLICAÇÃO (não é a de um freelancer específico) — usada no
# navegador pra inicializar o Card Payment Brick (formulário de cartão).
# Pode ser exposta no cliente, por isso o prefixo NEXT_PUBLIC_.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=sua-public-key-da-aplicacao

# Obrigatório em produção (valida a assinatura das notificações do webhook —
# sem isso o servidor recusa notificações em produção, ver route.ts).
# Painel da aplicação > Webhooks > Configurar notificações.
MERCADOPAGO_WEBHOOK_SECRET=sua-chave-secreta-do-webhook

# Chave de 32 bytes (base64) usada pra criptografar o access/refresh token do
# Mercado Pago de cada freelancer antes de gravar em `mp_connections`.
# Gere com: openssl rand -base64 32
# Trocar essa chave invalida conexões MP já salvas (o freelancer precisa
# reconectar a conta).
MP_TOKEN_ENCRYPTION_KEY=sua-chave-de-32-bytes-em-base64

# Protege /api/cron/payment-reminders — a Vercel manda esse valor sozinha no
# header Authorization quando o Cron (configurado em vercel.json) dispara.
# Gere com: openssl rand -base64 32
CRON_SECRET=sua-chave-aleatoria

# Resend — envio automático dos convites de equipe (plano Business).
# Painel: https://resend.com/api-keys
# Sem isso, os convites continuam funcionando, só sem envio de e-mail (o
# link fica disponível pra copiar no dashboard).
RESEND_API_KEY=sua-api-key-do-resend
# Precisa de um domínio verificado no Resend pra usar um remetente próprio;
# sem isso, use o remetente de teste deles (onboarding@resend.dev).
RESEND_FROM_EMAIL=PrestaCerto <convites@seudominio.com.br>
